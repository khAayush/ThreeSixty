# ─────────────────────────────────────────────────────────────────────────────
# ThreeSixty — Environment Variables
# Copy this file to .env and fill in your actual values.
#
#   cp .env.example .env
#   nano .env
#
# ─────────────────────────────────────────────────────────────────────────────


# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production


# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Docker deployment (local MongoDB service defined in docker-compose.yml):
MONGO_URI=mongodb://mongo:27017/threesixty

# MongoDB Atlas (cloud) — comment the line above and uncomment this one:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/threesixty


# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING


# ─── AES-256-GCM Message Encryption ─────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_EXACTLY


# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set Authorized JavaScript Origins to your server's public URL.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ─── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
# Use a Gmail App Password (not your account password).
# Enable 2FA on your Google account, then generate an App Password at:
#   https://myaccount.google.com/apppasswords
EMAIL=your-app-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx


# ─── CORS — Frontend Origin ──────────────────────────────────────────────────
# The URL users open in their browser (your server's public URL or IP).
# Both variables must point to the same origin.
# app.js uses FRONTEND_URL; utils/socket.js uses CLIENT_URL.
FRONTEND_URL=http://your-server-ip-or-domain
CLIENT_URL=http://your-server-ip-or-domain


# ─── Initial Setup Seeds ─────────────────────────────────────────────────────
# These are only used on the very first boot if no Settings document exists.
# You can change them interactively when you run: ./setup.sh
INSTITUTION_NAME=ThreeSixty
ALLOWED_EMAIL_DOMAINS=
FILTERED_EMAIL_NAMES=


# ─── Frontend Build Variables (baked in at docker build time) ────────────────
# VITE_API_URL: The full URL to the backend API as seen from the browser.
#
#   With Nginx proxy (recommended — only port 80 exposed):
#     VITE_API_URL=http://your-server-ip-or-domain/api
#
#   With direct backend access (backend port 5000 exposed):
#     VITE_API_URL=http://your-server-ip:5000/api
#
# IMPORTANT: This URL is compiled into the React bundle at build time.
# If you change it, you must rebuild: docker compose up --build -d
VITE_API_URL=http://your-server-ip-or-domain/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
