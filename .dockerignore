# .dockerignore — applies to the ROOT build context (used by backend/Dockerfile)
# Keep the build context small: backend only needs package*.json + backend/

# Reinstalled inside the container
node_modules/

# Frontend is built by its own separate container
frontend/

# Never bake secrets into the image — injected at runtime via env_file
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# Documentation (not needed at runtime)
*.md
PROJECT_TECHNICAL_OVERVIEW.md

# Deployment scripts (not needed inside container)
setup.sh
docker-compose.yml

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
